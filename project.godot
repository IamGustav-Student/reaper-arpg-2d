; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Las Cronicas de Reaper"
config/description="ARPG 2D Pixel Art — El Despertar de las Runas"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

GameManager="*res://autoloads/game_manager.gd"
SoundManager="*res://autoloads/sound_manager.gd"
SoulHarvestManager="*res://scripts/combat/soul_harvest_manager.gd"
SkillTreeManager="*res://scripts/skill_tree/skill_tree_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

